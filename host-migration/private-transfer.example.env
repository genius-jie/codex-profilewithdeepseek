# Example names only. Populate credentials locally, outside Git.
# Codex++ loopback gateway: http://127.0.0.1:15740/v1
# Configure the actual upstream/provider accounts in CodexManager on the target.
CODEXPP_GATEWAY_TOKEN=
# Complete actor header value when the chosen gateway route requires it.
CODEXPP_ACTOR_AUTHORIZATION=
# Claude Code inherits its token from this process environment.
ANTHROPIC_AUTH_TOKEN=
# Upstream credentials belong in native manager/provider entries, not in Git.
DEEPSEEK_UPSTREAM_API_KEY=
QWEN_UPSTREAM_API_KEY=
KIMI_UPSTREAM_API_KEY=
GLM_UPSTREAM_API_KEY=
